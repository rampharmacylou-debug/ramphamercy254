# Copy this to .env and fill in your Postgres details

#DATABASE_URL="postgresql://manifest_app:your_password_here@localhost:5432/manifest"

# Used to sign the role cookie — any long random string works
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#SESSION_SECRET="replace-with-a-long-random-string"

# Password for the Admin area (required). Used until an admin changes it under
# Settings -> Admin security; after that the changed password is used instead.
# To reset a forgotten password run:  DELETE FROM "AdminAuth";  then sign in
# with this value again.
#ADMIN_PASSWORD="choose-a-strong-password"

# --- Google Sheets export (optional) ---
# When these three are set, every Excel import automatically pushes the
# full current product list to this Google Sheet.
#
# Setup:
#   1. Go to console.cloud.google.com -> create a project (or use one you have).
#   2. APIs & Services -> Library -> enable "Google Sheets API".
#   3. APIs & Services -> Credentials -> Create Credentials -> Service Account.
#      Give it any name, no special roles needed.
#   4. Open the new service account -> Keys -> Add Key -> Create new key -> JSON.
#      This downloads a JSON file with "client_email" and "private_key".
#   5. Open your target Google Sheet -> Share -> paste the service account's
#      email (the "client_email" value) -> give it Editor access.
#   6. Copy the Sheet's ID from its URL:
#      https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL = the "client_email" from the JSON file
# GOOGLE_PRIVATE_KEY           = the "private_key" from the JSON file
#                                 (keep the \n characters as-is, in quotes)
# GOOGLE_SHEET_ID              = the ID from the sheet's URL
# GOOGLE_SHEET_TAB             = optional, defaults to "Products"
#GOOGLE_SERVICE_ACCOUNT_EMAIL=""
#GOOGLE_PRIVATE_KEY=""
#GOOGLE_SHEET_ID=""
#GOOGLE_SHEET_TAB=""

# --- Scheduled Excel backup to Google Drive (optional) ---
# Uses the SAME service account as above (no new credentials needed).
# Set these two and turn the switch on under Settings in the app.
#
# Setup:
#   1. Create (or pick) a folder in Google Drive for backups.
#   2. Share that folder with the service account's email (client_email
#      from the same JSON key used above) -> Editor access.
#   3. Copy the folder's ID from its URL:
#      https://drive.google.com/drive/folders/THIS_PART_IS_THE_ID
#
# GOOGLE_DRIVE_FOLDER_ID = the folder ID from step 3
#GOOGLE_DRIVE_FOLDER_ID=""

# --- Local-folder / full database backup (optional) ---
# Only needed if you turn on "Save to a folder on this PC" and/or
# "Also create a full database backup" under Settings in the app.
# The local folder path itself is set in the app, not here.
#
# PG_DUMP_PATH = full path to pg_dump.exe, only needed if it's not already
#                on your system PATH. It ships with PostgreSQL, usually at:
#                C:\Program Files\PostgreSQL\<version>\bin\pg_dump.exe
#PG_DUMP_PATH=""

# ── Automatic backup trigger (needed on Vercel / any host that can't keep a timer running) ──
# A long random value. A free pinger (e.g. cron-job.org) opens
#   https://YOUR-SITE/api/cron/backup?key=<this value>
# every minute; it only starts a backup when one is due.
#CRON_SECRET=""
